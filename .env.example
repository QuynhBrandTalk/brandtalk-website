# ============================================================================
# BRANDTALK WEBSITE - ENVIRONMENT CONFIGURATION
# ============================================================================

# SITE CONFIGURATION
NEXT_PUBLIC_SITE_URL=https://brandtalk.asia
NEXT_PUBLIC_CONTACT_EMAIL=contact@brandtalk.asia

# ============================================================================
# EMAIL SERVICE SETUP (REQUIRED FOR CONTACT FORM)
# ============================================================================
#
# Currently configured for: RESEND (Recommended - easiest setup)
# Alternative options: SendGrid, Mailgun
#
# RESEND SETUP:
# 1. Go to https://resend.com
# 2. Sign up for free account
# 3. Get your API key from dashboard
# 4. Add key below as: RESEND_API_KEY=re_xxxxxxxxxxxx
# 5. Run: npm install resend
# 6. Uncomment the Resend imports in app/api/contact/route.ts
#
# Emails will be sent to: quynhphan.mar@gmail.com
#

RESEND_API_KEY=

# Optional: SendGrid Alternative
# https://sendgrid.com - Get API key from settings
SENDGRID_API_KEY=

# Optional: Mailgun Alternative
# https://mailgun.com - Get API key from domain settings
MAILGUN_API_KEY=

# ============================================================================
# ANALYTICS (OPTIONAL)
# ============================================================================
# Plausible Analytics (privacy-first)
# https://plausible.io
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=brandtalk.asia

# Or Google Analytics
NEXT_PUBLIC_GA_ID=

# ============================================================================
# CALENDAR BOOKING (OPTIONAL)
# ============================================================================
# For scheduling discovery calls
# Calendly: https://calendly.com
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/quynhphan

# Or Cal.com: https://cal.com
NEXT_PUBLIC_CALCOM_URL=

# ============================================================================
# CMS INTEGRATION (OPTIONAL - FOR FUTURE BLOG/CONTENT)
# ============================================================================
# Sanity.io CMS
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_TOKEN=

# ============================================================================
# ENVIRONMENT
# ============================================================================
NODE_ENV=development
